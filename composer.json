{
    "name": "ecuafact/sdk",
    "description": "Cliente oficial en PHP del API publico de facturacion electronica Ecuafact (contrato v1).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ecuafact",
        "sri",
        "facturacion-electronica",
        "ecuador",
        "api",
        "sdk"
    ],
    "homepage": "https://docsapi.ecuafact.com/v1/guias/sdk-php",
    "support": {
        "docs": "https://docsapi.ecuafact.com/v1/guias/sdk-php"
    },
    "authors": [
        {
            "name": "Ecuanexus"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "suggest": {
        "psr/http-client": "Para usar Psr18Transport con tu cliente PSR-18 (Guzzle, Symfony HttpClient).",
        "psr/http-factory": "Fabricas PSR-17 que necesita Psr18Transport."
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Ecuafact\\Sdk\\": "src/"
        },
        "files": [
            "src/Contracts/contracts.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Ecuafact\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
