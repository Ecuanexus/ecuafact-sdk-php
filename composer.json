{
    "name": "ecuafact/sdk",
    "description": "Cliente oficial de Ecuafact para PHP: emite y consulta los seis comprobantes electronicos del SRI de Ecuador (factura, liquidacion de compra, notas de credito y debito, guia de remision y retencion). Incluye validacion previa, seguimiento hasta el estado final, descarga de RIDE y XML, reintentos seguros con Idempotency-Key, cupo, consultas al SRI, catalogos, estado del servicio, perfil del emisor, destinos de webhooks y verificacion de su firma.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ecuafact",
        "sri",
        "facturacion-electronica",
        "ecuador",
        "api",
        "sdk"
    ],
    "homepage": "https://docsapi.ecuafact.com/v1/guias/sdk-php",
    "support": {
        "docs": "https://docsapi.ecuafact.com/v1/guias/sdk-php"
    },
    "authors": [
        {
            "name": "Ecuanexus"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "suggest": {
        "psr/http-client": "Para usar Psr18Transport con tu cliente PSR-18 (Guzzle, Symfony HttpClient).",
        "psr/http-factory": "Fabricas PSR-17 que necesita Psr18Transport."
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Ecuafact\\Sdk\\": "src/"
        },
        "files": [
            "src/Contracts/contracts.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Ecuafact\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "archive": {
        "exclude": [
            "/tests",
            "/phpunit.xml",
            "/.phpunit.cache",
            "/.gitignore",
            "/.gitattributes",
            "/vendor",
            "/composer.lock",
            "*.log"
        ]
    }
}
